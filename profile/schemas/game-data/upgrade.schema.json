{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Upgrade model",
  "type": "object",
  "required": [
    "kind",
    "id"
  ],
  "properties": {
    "kind": {
      "const": "upgrade"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "experiencePrice": {
      "type": "number"
    },
    "pathIndex": {
      "type": "integer"
    },
    "tier": {
      "type": "integer"
    },
    "localizationKey": {
      "type": "string",
      "minLength": 1
    },
    "isAdvanced": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
