{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared model shapes",
  "$defs": {
    "model": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "namedModel": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "stringTable": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
