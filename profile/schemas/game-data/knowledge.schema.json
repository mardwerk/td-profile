{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge model",
  "type": "object",
  "required": [
    "kind",
    "id"
  ],
  "properties": {
    "kind": {
      "const": "knowledge"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "modifier": {
      "$ref": "mod.schema.json"
    },
    "category": {
      "type": [
        "string",
        "integer"
      ]
    },
    "requiredInvestment": {
      "type": "integer"
    },
    "price": {
      "type": "number"
    }
  },
  "additionalProperties": true
}
