{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mod model",
  "type": "object",
  "required": [
    "kind",
    "id"
  ],
  "properties": {
    "kind": {
      "const": "mod"
    },
    "id": {
      "type": "string"
    },
    "modifiers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "model.schema.json#/$defs/model"
      }
    }
  },
  "additionalProperties": true
}
