{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source model structure contracts",
  "description": "Portable vocabulary for strict source field shapes. All listed fields are required; undeclared fields fail unless additionalFields declares a value shape.",
  "type": "object",
  "properties": {
    "requireContracts": {
      "type": "boolean"
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "captureRevision": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "captureRevision",
        "method",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "contracts"
      ]
    },
    {
      "required": [
        "includes"
      ]
    }
  ],
  "$defs": {
    "contract": {
      "type": "object",
      "properties": {
        "sourceType": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "additionalFields": {
          "$ref": "#/$defs/shape"
        }
      },
      "required": [
        "sourceType",
        "fields"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "$ref": "#/$defs/shape"
        }
      },
      "required": [
        "field",
        "shape"
      ],
      "additionalProperties": false
    },
    "shape": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "null",
                "boolean",
                "integer",
                "number"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "string"
            },
            "enum": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "model"
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "type",
            "models"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "object"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field"
              }
            },
            "additionalFields": {
              "$ref": "#/$defs/shape"
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "array"
            },
            "items": {
              "$ref": "#/$defs/shape"
            }
          },
          "required": [
            "type",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "array"
            },
            "maxItems": {
              "const": 0
            }
          },
          "required": [
            "type",
            "maxItems"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "anyOf": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/shape"
              },
              "minItems": 2
            }
          },
          "required": [
            "anyOf"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
