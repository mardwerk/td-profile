{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native numerical units",
  "description": "Documents native numeric fields without conversion or mutation. Present bound values must be numeric.",
  "type": "object",
  "properties": {
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "models",
          "field",
          "unit",
          "meaning"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "units",
    "bindings"
  ],
  "additionalProperties": false
}
